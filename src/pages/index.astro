---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<div class="hero">
				<div class="headshot-container">
					<!-- Replace this URL with your actual headshot image, e.g., "/headshot.jpg" once you add it to the public folder -->
					<img src="/headshot.png" alt="Luke Daniel" class="headshot" />
				</div>
				<div class="hero-text">
					<h1>Luke Daniel</h1>
					<p class="subtitle">
						Software engineer and graduate student in business analytics, AI, and sports technology.
					</p>
					<a href="/about" class="about-link">More about me &rarr;</a>
				</div>
			</div>

			<section class="section" aria-labelledby="professional-experience">
				<h2 id="professional-experience">Professional Experience</h2>
				<a href="/projects/vectorscribe" class="glass-card professional-card">
					<div class="professional-images"><img src="/assets/images/thumbnails/vectorscribe-einstein.webp" alt="Colorful Einstein portrait printed on a VectorScribe optical sample" width="720" height="480" loading="lazy" /><img src="/assets/images/projects/vectorscribe-hardware.webp" alt="VectorScribe optical microprinting hardware" width="1600" height="1100" loading="lazy" /></div>
					<div class="professional-summary">
						<img class="company-logo" src="/assets/images/projects/vectorscribe-logo.png" alt="VectorScribe logo" width="556" height="376" />
						<div>
					<span class="project-date">Software Engineer · August 2025 - Present</span>
					<h3>VectorScribe</h3>
					<p>Building Python software for laser holographic microprinting.</p>
						</div>
					</div>
				</a>
			</section>

			<section class="section">
				<h2>Academic Projects</h2>
				<div class="projects-grid">
					<a href="/projects/gasp-violations" class="glass-card project-card">
						<img class="project-thumbnail" src="/assets/images/thumbnails/gasp-dashboard.webp" alt="GASP dashboard with a facility map and air-quality violation charts" width="960" height="540" loading="lazy" />
						<span class="project-date">January - April 2025</span>
						<h3>Visualizing Industrial Impact in Allegheny County</h3>
						<p>A data analytics capstone project for GASP (Group Against Smog & Pollution) visualizing 5 years of air quality violations and fines from major industrial polluters.</p>
					</a>
					<a href="/projects/movie-recommender" class="glass-card project-card">
						<img class="project-thumbnail" src="/assets/images/thumbnails/movie-architecture.webp" alt="Movie chatbot architecture connecting the frontend, Python API, language model, and database" width="960" height="540" loading="lazy" />
						<span class="project-date">August - December 2024</span>
						<h3>Movie Recommendation Application</h3>
						<p>A computer science capstone connecting a natural-language interface, the OpenAI API, and PostgreSQL to manage user profiles, update movie preferences, and retrieve recommendations.</p>
					</a>
				</div>
			</section>

			<section class="section">
				<h2>Personal Projects</h2>
				<div class="projects-grid">
					<a href="/projects/fourth-down-calc" class="glass-card project-card">
						<h3>Fourth Down Calculator</h3>
						<p>Explore real NFL fourth-down plays and compare decisions with a custom matchup-aware model incorporating team ratings, kicker performance, and weather.</p>
					</a>
					<a href="/projects/amc-guide" class="glass-card project-card">
						<h3>AMC Guide</h3>
						<p>Compare AMC showtimes across theaters, filter by format and seating options, and pin screenings in a timeline view.</p>
					</a>
					<a href="/projects/sports-attendance" class="glass-card project-card">
						<h3>NY Sports Attendance Predictor</h3>
						<p>Explore attendance estimates for eight NY-area sports teams using historical game data, weather, and a gradient boosting model.</p>
					</a>
					<a href="/projects/nfl-uniforms" class="glass-card project-card">
						<h3>NFL Uniform Mixer</h3>
						<p>Mix helmets, jerseys, pants, and socks for NFL matchups, then export your combinations as a PNG.</p>
					</a>
				</div>
			</section>

			<section class="section writeups-section">
				<h2>Short Data Analysis Write-Ups</h2>
				<ul class="post-list">
					{
						posts.map((post) => (
							<li>
								<a href={`/blog/${post.slug}/`} class="article-link">
									<span>{post.data.title}</span>
									<time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString()}</time>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero {
		display: flex;
		align-items: center;
		gap: 3em;
		padding: 2em 0 3em 0;
		text-align: left;
	}
	.headshot-container {
		flex-shrink: 0;
		width: 200px;
		aspect-ratio: 4 / 5;
		border-radius: 12px;
		overflow: hidden;
		background: var(--bg-card);
		border: 4px solid var(--border-color);
		box-shadow: var(--box-shadow);
	}
	.headshot {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.hero-text h1 {
		margin-bottom: 0.25em;
	}
	.subtitle {
		font-size: 1.25em;
		color: var(--text-muted);
		max-width: 600px;
		margin: 0;
	}
	.about-link {
		display: inline-block;
		margin-top: 1em;
		font-weight: 600;
	}
	@media (max-width: 720px) {
		.hero {
			flex-direction: column;
			align-items: flex-start;
			gap: 2em;
		}
		.projects-grid {
			grid-template-columns: 1fr;
		}
	}
	.section {
		margin-bottom: 3em;
	}
	.writeups-section {
		margin-top: 1em;
	}
	.writeups-section h2 {
		font-size: 1.4rem;
		margin-bottom: 0.6em;
	}
	.writeups-section ul.post-list {
		gap: 0.35em;
	}
	.projects-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 400px), 1fr));
		gap: 2em;
		margin-top: 1.5em;
	}
	.professional-card {
		display: grid;
		grid-template-columns: 120px minmax(0, 1fr);
		grid-template-columns: 1fr;
		align-items: center;
		gap: 1.5rem;
	}
	.company-logo {
		width: 120px;
		max-width: 100%;
		height: auto;
		border-radius: 8px;
		flex-shrink: 0;
	}
	.professional-images {
		display: flex;
		gap: 0.75rem;
	}
	.professional-images img {
		width: calc(50% - 0.375rem);
		height: 240px;
		object-fit: cover;
		background: #fff;
		border-radius: 8px;
	}
	.professional-copy {
	}
	.professional-summary {
		display: flex;
		align-items: center;
		gap: 1.5rem;
	}
	@media (max-width: 540px) {
		.professional-card {
			grid-template-columns: 1fr;
			align-items: flex-start;
		}
		.company-logo {
			width: 96px;
		}
		.professional-images {
			width: 100%;
		}
	}
	.professional-card p {
		color: var(--text-muted);
	}
	.professional-card .work-link {
		font-weight: 600;
	}
	.professional-card .project-date {
		display: block;
	}
	.project-card {
		display: flex;
		flex-direction: column;
	}
	.project-date {
		color: var(--text-muted);
		font-size: 0.9em;
		margin-bottom: 0.5em;
	}
	.project-thumbnail, .article-thumbnail {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 16 / 9;
		object-fit: contain;
		background: #fff;
		border-radius: 8px;
	}
	.project-thumbnail {
		margin-bottom: 1.25em;
	}
	.article-thumbnail {
		aspect-ratio: 16 / 9;
		background: transparent;
	}
	ul.post-list li a.article-card {
		display: grid;
		grid-template-columns: minmax(0, 240px) minmax(0, 1fr);
		align-items: center;
		gap: 1.5em;
	}
	ul.post-list li a.article-link {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1em;
		padding: 0.35em 0;
		font-size: 1.05em;
	}
	.article-link time {
		color: var(--text-muted);
		font-size: 0.85em;
		white-space: nowrap;
	}
	@media (max-width: 720px) {
		ul.post-list li a.article-link {
			align-items: flex-start;
			flex-direction: column;
			gap: 0.15em;
		}
	}
	.project-card p, ul.post-list li p {
		margin: 0;
		color: var(--text-muted);
		font-size: 1.05em;
	}
	.btn {
		display: inline-block;
		font-weight: 600;
		color: var(--accent);
	}
	ul.post-list li a {
		text-decoration: none;
	}
	ul.post-list li a:hover h3 {
		color: var(--accent);
	}
</style>
