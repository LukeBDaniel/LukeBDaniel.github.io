---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<div class="hero">
				<div class="headshot-container">
					<!-- Replace this URL with your actual headshot image, e.g., "/headshot.jpg" once you add it to the public folder -->
					<img src="/headshot.png" alt="Luke Daniel" class="headshot" />
				</div>
				<div class="hero-text">
					<h1>Luke Daniel</h1>
					<p class="subtitle">
						Software engineer and graduate student working across data science, applied AI, and sports analytics.
					</p>
					<a href="/about" class="about-link">More about me &rarr;</a>
				</div>
			</div>

			<section class="section">
				<h2>Academic Projects</h2>
				<div class="projects-grid">
					<a href="/projects/gasp-violations" class="glass-card project-card">
						<img class="project-thumbnail" src="/assets/images/thumbnails/gasp-dashboard.webp" alt="GASP dashboard with a facility map and air-quality violation charts" width="960" height="540" loading="lazy" />
						<span class="project-date">January - April 2025</span>
						<h3>Visualizing Industrial Impact in Allegheny County</h3>
						<p>A data analytics capstone project for GASP (Group Against Smog & Pollution) visualizing 5 years of air quality violations and fines from major industrial polluters.</p>
					</a>
					<a href="/projects/movie-recommender" class="glass-card project-card">
						<img class="project-thumbnail" src="/assets/images/thumbnails/movie-architecture.webp" alt="Movie chatbot architecture connecting the frontend, Python API, language model, and database" width="960" height="540" loading="lazy" />
						<span class="project-date">August - December 2024</span>
						<h3>Movie Recommendation Application</h3>
						<p>A computer science capstone connecting a natural-language interface, the OpenAI API, and PostgreSQL to manage user profiles, update movie preferences, and retrieve recommendations.</p>
					</a>
				</div>
			</section>

			<section class="section">
				<h2>Personal Projects</h2>
				<div class="projects-grid">
					<a href="/projects/sports-attendance" class="glass-card project-card">
						<h3>NY Sports Attendance Predictor</h3>
						<p>An interactive Machine Learning tool predicting home game attendance for major NY-area sports teams based on weather, form, and rivalries.</p>
					</a>
					<a href="/projects/amc-guide" class="glass-card project-card">
						<h3>AMC Guide</h3>
						<p>A web application with a custom scraper and React frontend for filtering and organizing AMC movie showtimes.</p>
					</a>
					<a href="/projects/nfl-uniforms" class="glass-card project-card">
						<h3>NFL Uniform Mixer</h3>
						<p>An interactive static web app to visualize and customize matchups between NFL teams.</p>
					</a>
					<!-- Add more projects here in the future -->
				</div>
			</section>

			<section class="section">
				<h2>Articles</h2>
				<ul class="post-list">
					{
						posts.map((post) => (
							<li>
								<a href={`/blog/${post.slug}/`} class="glass-card article-card">
									{post.data.thumbnail && <img class="article-thumbnail" src={post.data.thumbnail} alt={post.data.thumbnailAlt ?? ''} width={post.data.thumbnailWidth} height={post.data.thumbnailHeight} loading="lazy" />}
									<div class="article-copy">
									<span class="date">{post.data.pubDate.toLocaleDateString()}</span>
									<h3>{post.data.title}</h3>
									<p>{post.data.description}</p>
									</div>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero {
		display: flex;
		align-items: center;
		gap: 3em;
		padding: 2em 0 3em 0;
		text-align: left;
	}
	.headshot-container {
		flex-shrink: 0;
		width: 200px;
		aspect-ratio: 4 / 5;
		border-radius: 12px;
		overflow: hidden;
		background: var(--bg-card);
		border: 4px solid var(--border-color);
		box-shadow: var(--box-shadow);
	}
	.headshot {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.hero-text h1 {
		margin-bottom: 0.25em;
	}
	.subtitle {
		font-size: 1.25em;
		color: var(--text-muted);
		max-width: 600px;
		margin: 0;
	}
	.about-link {
		display: inline-block;
		margin-top: 1em;
		font-weight: 600;
	}
	@media (max-width: 720px) {
		.hero {
			flex-direction: column;
			align-items: flex-start;
			gap: 2em;
		}
		.projects-grid {
			grid-template-columns: 1fr;
		}
	}
	.section {
		margin-bottom: 3em;
	}
	.projects-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 400px), 1fr));
		gap: 2em;
		margin-top: 1.5em;
	}
	.project-card {
		display: flex;
		flex-direction: column;
	}
	.project-date {
		color: var(--text-muted);
		font-size: 0.9em;
		margin-bottom: 0.5em;
	}
	.project-thumbnail, .article-thumbnail {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 16 / 9;
		object-fit: contain;
		background: #fff;
		border-radius: 8px;
	}
	.project-thumbnail {
		margin-bottom: 1.25em;
	}
	.article-thumbnail {
		aspect-ratio: 16 / 9;
		background: transparent;
	}
	ul.post-list li a.article-card {
		display: grid;
		grid-template-columns: minmax(0, 240px) minmax(0, 1fr);
		align-items: center;
		gap: 1.5em;
	}
	@media (max-width: 720px) {
		ul.post-list li a.article-card {
			grid-template-columns: 1fr;
		}
	}
	.project-card p, ul.post-list li p {
		margin: 0;
		color: var(--text-muted);
		font-size: 1.05em;
	}
	.btn {
		display: inline-block;
		font-weight: 600;
		color: var(--accent);
	}
	ul.post-list li a {
		text-decoration: none;
	}
	ul.post-list li a:hover h3 {
		color: var(--accent);
	}
</style>
