---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import HomeProjectCard from '../components/HomeProjectCard.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const experience = {
	href: '/projects/vectorscribe', title: 'VectorScribe', size: 'full' as const,
	context: 'Software Engineer', date: 'August 2025 - Present',
	description: 'Building Python software for laser holographic microprinting.',
	logo: { src: '/assets/images/projects/vectorscribe-logo.png', alt: 'VectorScribe logo', width: 556, height: 376 },
	images: [
		{ src: '/assets/images/thumbnails/vectorscribe-einstein.webp', alt: 'Colorful Einstein portrait printed on a VectorScribe optical sample', width: 720, height: 480 },
		{ src: '/assets/images/projects/vectorscribe-hardware.webp', alt: 'VectorScribe optical microprinting hardware', width: 1600, height: 1100 },
	],
};

const projects = [
	{
		href: '/projects/startup-signals', title: 'NJ Startup Signals', size: 'full' as const,
		context: 'Stevens Institute of Technology | Business + AI Hackathon | 2nd Place', date: 'September 2026',
		description: 'A team-built platform for discovering New Jersey startups through public funding, research, and patent signals. I built the backend, data pipelines, database, and API integrations.',
		images: [
			{ src: '/assets/images/projects/startup-signals-interface.png', alt: 'NJ Startup Signals interface showing a New Jersey startup map and signal-weight controls', width: 2814, height: 1318 },
			{ src: '/assets/images/projects/hackathon-group.webp', alt: 'Hackathon participants and organizers at the Stevens award ceremony', width: 2000, height: 1333 },
		],
	},
	{
		href: '/projects/logr', title: 'Logr - Book Tracking App', size: 'full' as const,
		context: 'Personal project', date: 'August 2025 - Present',
		description: 'A native iOS reading journal for tracking books, editions, progress, and the people you read with. Built with SwiftUI, FastAPI, and PostgreSQL.',
		logo: { src: '/assets/images/projects/logr-icon.webp', alt: 'Logr app icon', width: 320, height: 320 },
	},
	{
		href: '/projects/movie-recommender', title: 'Movie Recommendation Application', size: 'half' as const,
		context: 'University of Pittsburgh | ADMT Lab', date: 'August - December 2024',
		description: 'A computer science capstone connecting a natural-language interface, the OpenAI API, and PostgreSQL to manage user profiles, update movie preferences, and retrieve recommendations.',
		images: [{ src: '/assets/images/thumbnails/movie-architecture.webp', alt: 'Movie chatbot architecture connecting the frontend, Python API, language model, and database', width: 960, height: 540 }],
	},
	{
		href: '/projects/gasp-violations', title: 'Air Quality Dashboard - Visualizing Industrial Impact in Allegheny County', size: 'half' as const,
		context: 'University of Pittsburgh | GASP', date: 'January - April 2025',
		description: 'A data analytics capstone project for GASP (Group Against Smog & Pollution) visualizing 5 years of air quality violations and fines from major industrial polluters.',
		images: [{ src: '/assets/images/thumbnails/gasp-dashboard.webp', alt: 'GASP dashboard with a facility map and air-quality violation charts', width: 960, height: 540 }],
	},
	{
		href: '/projects/fourth-down-calc', title: 'Fourth Down Calculator', size: 'half' as const,
		context: 'Personal project', date: 'September 2026',
		description: 'Explore real NFL fourth-down plays with custom machine-learning models for regulation and overtime win probability, plus team, kicker, and weather adjustments.',
		images: [{ src: '/assets/images/thumbnails/fourth_down_calc.png', alt: 'Fourth Down Calculator interface showing an NFL game situation and decision recommendations', width: 2394, height: 1316 }],
	},
	{
		href: '/projects/amc-guide', title: 'AMC Guide', size: 'half' as const,
		context: 'Personal project', date: 'June 2026',
		description: 'Compare AMC showtimes across local theaters, filter by format and seating options, and pin screenings in a timeline view.',
		images: [{ src: '/assets/images/thumbnails/amc_guide.png', alt: 'AMC Guide interface showing movie showtimes and filtering controls', width: 2354, height: 1296 }],
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<div class="hero">
				<div class="headshot-container">
					<!-- Replace this URL with your actual headshot image, e.g., "/headshot.jpg" once you add it to the public folder -->
					<img src="/headshot.png" alt="Luke Daniel" class="headshot" />
				</div>
				<div class="hero-text">
					<h1>Luke Daniel</h1>
					<p class="subtitle">
						Software engineer and graduate student in business analytics, AI, and sports technology.
					</p>
					<a href="/about" class="about-link">More about me &rarr;</a>
				</div>
			</div>

			<section class="section" aria-labelledby="professional-experience">
				<h2 id="professional-experience">Experience</h2>
				<HomeProjectCard {...experience} />
			</section>

			<section class="section" aria-labelledby="featured-projects">
				<h2 id="featured-projects">Projects</h2>
				<div class="projects-grid">
					{projects.map((project) => <HomeProjectCard {...project} />)}
				</div>
			</section>

			<section class="section more-work-section">
				<a href="/other-projects/" class="more-work-link">Other personal projects and data write-ups &rarr;</a>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero {
		display: flex;
		align-items: center;
		gap: 3em;
		padding: 2em 0 3em 0;
		text-align: left;
	}
	.headshot-container {
		flex-shrink: 0;
		width: 200px;
		aspect-ratio: 4 / 5;
		border-radius: 12px;
		overflow: hidden;
		background: var(--bg-card);
		border: 4px solid var(--border-color);
		box-shadow: var(--box-shadow);
	}
	.headshot {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.hero-text h1 {
		margin-bottom: 0.25em;
	}
	.subtitle {
		font-size: 1.25em;
		color: var(--text-muted);
		max-width: 600px;
		margin: 0;
	}
	.about-link {
		display: inline-block;
		margin-top: 1em;
		font-weight: 600;
	}
	@media (max-width: 720px) {
		.hero {
			flex-direction: column;
			align-items: flex-start;
			gap: 2em;
		}
		.projects-grid {
			grid-template-columns: 1fr;
		}
	}
	.section {
		margin-bottom: 3em;
	}
	.more-work-section {
		margin-top: 1em;
	}
	.more-work-link {
		font-weight: 600;
	}
	.projects-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 400px), 1fr));
		gap: 2em;
		margin-top: 1.5em;
	}
</style>
