---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`About Me | ${SITE_TITLE}`} description="Learn more about Luke Daniel." />
	</head>
	<body>
		<Header />
		<main>
			<h1 class="page-title">About Me</h1>
	<div class="about-container">
		<div class="headshot-column">
			<img src="/headshot.png" alt="Luke Daniel" class="headshot" />
			<div class="locations-wrapper">
				<div class="location-badge">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
						<circle cx="12" cy="10" r="3"></circle>
					</svg>
					Hoboken, NJ
				</div>
			</div>
		</div>
		<div class="bio">
			<p>
				Hi, I'm Luke Daniel, a graduate student pursuing degrees in Business Analytics & Artificial Intelligence at Stevens Institute of Technology and Sports Technologies & Digital Transformation at Real Madrid Graduate School, Universidad Europea. I also work as a Software Engineer at VectorScribe, LLC. I earned my bachelor's degree in Data Science and Computer Science from the University of Pittsburgh.
			</p>
			<p>
				My work sits at the intersection of software, data, and applied AI. At VectorScribe, I build full-stack Python control software for laser holographic microprinting, improving everything from image-processing and hardware-control routines to user interfaces and deployment. Whether I'm analyzing sports data, building AI-powered tools, or designing intuitive interfaces, I enjoy turning complex systems into useful, accessible experiences.
			</p>
			<p>
				I’m pursuing opportunities in data analytics and engineering, with a particular interest in the sports industry.
			</p>
		</div>
	</div>

	<hr class="resume-divider" />

	<div class="resume-section">
		<h2>Education</h2>
		<div class="resume-item glass-card">
			<div class="resume-header">
				<h3>Stevens Institute of Technology</h3>
				<span class="resume-location">Hoboken, NJ</span>
			</div>
			<div class="resume-subtitle-row">
				<div class="resume-subtitle">
					<strong>Master of Science, Business Analytics & Artificial Intelligence</strong>
				</div>
				<span class="resume-date">Expected May 2027</span>
			</div>
		</div>

		<div class="resume-item glass-card">
			<div class="resume-header">
				<h3>Real Madrid Graduate School, Universidad Europea</h3>
				<span class="resume-location">Madrid, Spain</span>
			</div>
			<div class="resume-subtitle-row">
				<div class="resume-subtitle">
					<strong>Master of Science, Sports Technologies & Digital Transformation</strong>
				</div>
				<span class="resume-date">Expected June 2027</span>
			</div>
		</div>

		<div class="resume-item glass-card">
			<div class="resume-header">
				<h3>University of Pittsburgh</h3>
				<span class="resume-location">Pittsburgh, PA</span>
			</div>
			<div class="resume-subtitle-row">
				<div class="resume-subtitle">
					<strong>Bachelor of Science, Data Science & Computer Science</strong>
				</div>
				<span class="resume-date">May 2025</span>
			</div>
			<p class="resume-details">Magna Cum Laude | GPA: 3.75/4.00</p>
		</div>
	</div>

	<div class="resume-section">
		<h2>Experience</h2>
		
		<a class="resume-item glass-card resume-link" href="/projects/vectorscribe">
			<div class="resume-header">
				<h3>VectorScribe, LLC</h3>
				<span class="resume-location">Bethlehem, PA</span>
			</div>
			<div class="resume-subtitle-row">
				<div class="resume-subtitle">
					<strong>Software Engineer</strong>
				</div>
				<span class="resume-date">August 2025 – Present</span>
			</div>
			<ul class="resume-bullets">
				<li>Engineering full-stack Python software for a laser holographic microprinter, consolidating legacy codebases into one platform supporting multiple printer generations.</li>
				<li>Designing a custom Python user interface for configuring print patterns and hardware parameters.</li>
				<li>Substantially reduced print execution time by refactoring image processing and hardware control routines.</li>
				<li>Established the company GitHub organization and lab deployment pipelines to streamline collaboration.</li>
			</ul>
		</a>

		<div class="resume-item glass-card">
			<div class="resume-header">
				<h3>NeuroTechR3</h3>
				<span class="resume-location">Newark, NJ</span>
			</div>
			<div class="resume-subtitle-row">
				<div class="resume-subtitle">
					<strong>Data Science Intern</strong>
				</div>
				<span class="resume-date">June – August 2023</span>
			</div>
		</div>
	</div>

	<div class="resume-section">
		<h2>Projects</h2>

		<a class="resume-item glass-card resume-link" href="/projects/logr">
			<div class="resume-header">
				<h3>Logr – Social Book Tracking iOS App</h3>
			</div>
			<div class="resume-subtitle-row">
				<div class="resume-subtitle">
					<strong>Personal Project</strong>
				</div>
				<span class="resume-date">August 2025 – Present</span>
			</div>
			<ul class="resume-bullets">
				<li>Developing a native SwiftUI iOS app for discovering books, tracking reading progress, writing reviews, creating custom lists, and following authors and other readers.</li>
				<li>Building a Python/FastAPI backend integrating book data from public APIs, with PostgreSQL for storing and managing book and user data and SwiftData for offline library storage, local caching, and synchronization.</li>
			</ul>
		</a>

		<a class="resume-item glass-card resume-link" href="/projects/startup-signals">
			<div class="resume-header">
				<h3>NJ Startup Signals</h3>
				<span class="resume-location">Hoboken, NJ</span>
			</div>
			<div class="resume-subtitle-row">
				<div class="resume-subtitle">
					<strong>Stevens Business + AI Hackathon | 2nd Place</strong>
				</div>
				<span class="resume-date">September 2026</span>
			</div>
			<ul class="resume-bullets">
				<li>Integrated multiple government grant and patent data sources into a unified Supabase database.</li>
				<li>Built API and ingestion pipelines powering statewide startup evaluation, sector rankings, and ecosystem analysis.</li>
			</ul>
		</a>

		<a class="resume-item glass-card resume-link" href="/projects/gasp-violations">
			<div class="resume-header">
				<h3>Air Quality Dashboard</h3>
				<span class="resume-location">Pittsburgh, PA</span>
			</div>
			<div class="resume-subtitle-row">
				<div class="resume-subtitle">
					<strong>University of Pittsburgh | Group Against Smog and Pollution (GASP)</strong>
				</div>
				<span class="resume-date">January – April 2025</span>
			</div>
			<ul class="resume-bullets">
				<li>Built a dashboard using Looker Studio mapping steel facilities across Western Pennsylvania to visualize and analyze air-quality violations and associated fines.</li>
				<li>Collaborated with nonprofit stakeholders to gather requirements and refine dashboard content.</li>
			</ul>
		</a>

		<a class="resume-item glass-card resume-link" href="/projects/movie-recommender">
			<div class="resume-header">
				<h3>Movie Recommendation Application</h3>
				<span class="resume-location">Pittsburgh, PA</span>
			</div>
			<div class="resume-subtitle-row">
				<div class="resume-subtitle">
					<strong>University of Pittsburgh | Advanced Data Management Technologies Laboratory</strong>
				</div>
				<span class="resume-date">August – December 2024</span>
			</div>
			<ul class="resume-bullets">
				<li>Developed a full-stack application supporting a movie recommendation system, integrating a natural-language interface, the OpenAI API, and PostgreSQL to manage user profiles and preferences.</li>
				<li>Built a pipeline that translated user requests into SQL and database query results into natural-language responses, enabling preference updates and recommendation retrieval.</li>
			</ul>
		</a>
	</div>

	<div class="resume-section">
		<h2>Skills</h2>
		<div class="resume-item glass-card skills-grid">
			<div class="skill-category">
				<strong>Programming & Development</strong>
				<ul>
					<li>Python</li>
					<li>SQL</li>
					<li>Swift</li>
					<li>SwiftUI</li>
					<li>FastAPI</li>
					<li>Git/GitHub</li>
					<li>R</li>
					<li>Java</li>
				</ul>
			</div>
			<div class="skill-category">
				<strong>Data Management & Analytics</strong>
				<ul>
					<li>PostgreSQL</li>
					<li>Supabase</li>
					<li>SwiftData</li>
					<li>pandas</li>
					<li>Looker Studio</li>
				</ul>
			</div>
		</div>
	</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.page-title {
		margin-bottom: 1em;
	}
	.about-container {
		display: flex;
		flex-direction: column;
		gap: 2em;
		margin-top: 1em;
	}
	.headshot-column {
		flex-shrink: 0;
		width: 100%;
		max-width: 300px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		gap: 0.5em;
	}
	.headshot {
		width: 100%;
		height: auto;
		display: block;
		object-fit: cover;
		margin: 0 !important;
		border-radius: 12px;
		background: var(--bg-card);
		border: 4px solid var(--border-color);
		box-shadow: var(--box-shadow);
	}
	.bio p {
		margin-bottom: 1.5em;
		font-size: 1.1em;
		line-height: 1.8;
	}
	.locations-wrapper {
		display: flex;
		flex-direction: column;
		gap: 0.1em;
		margin-top: 0.5em;
	}
	.location-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.4em;
		font-size: 0.95em;
		color: var(--text-muted);
		transition: color 0.2s ease;
	}
	.location-badge:hover {
		color: var(--text-main);
	}
	.location-badge:hover svg {
		stroke: var(--accent);
	}
	.location-badge svg {
		transition: stroke 0.2s ease;
	}
	@media (min-width: 768px) {
		.about-container {
			flex-direction: row;
			align-items: flex-start;
			gap: 3em;
		}
		.headshot-column {
			width: 250px;
			margin: 0;
		}
	}
	
	.resume-divider {
		border: 0;
		height: 1px;
		background: var(--border-color);
		margin: 3em 0;
	}
	.resume-section {
		margin-bottom: 3em;
	}
	.resume-section h2 {
		margin-bottom: 1em;
		font-size: 1.8em;
	}
	.resume-item {
		margin-bottom: 1.5em;
		padding: 1.5em 2em;
	}
	.resume-link {
		display: block;
		color: inherit;
	}
	.resume-link:hover,
	.resume-link:focus-visible {
		color: inherit;
		background: var(--bg-card-hover);
		border-color: var(--accent);
	}
	.resume-link:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 3px;
	}
	.resume-header {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		flex-wrap: wrap;
		gap: 1em;
		margin-bottom: 0.2em;
	}
	.resume-header h3 {
		margin: 0;
		font-size: 1.3em;
		color: var(--text-main);
	}
	.resume-header .linked-title {
		color: var(--accent);
	}
	.resume-link:hover .linked-title {
		color: var(--accent-hover);
	}
	.resume-location {
		color: var(--text-main);
		font-size: 0.95em;
		font-weight: 500;
	}
	.resume-subtitle-row {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		flex-wrap: wrap;
		gap: 1em;
		margin-bottom: 1em;
	}
	.resume-date {
		color: var(--text-muted);
		font-size: 0.9em;
	}
	.resume-subtitle {
		color: var(--accent);
		font-size: 1.05em;
		margin: 0;
	}
	.resume-details {
		margin: 0;
		color: var(--text-muted);
	}
	.resume-bullets {
		margin: 0;
		padding-left: 1.2em;
		color: var(--text-muted);
	}
	.resume-bullets li {
		margin-bottom: 0.5em;
		line-height: 1.6;
	}
	.skills-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: 2em;
	}
	.skill-category strong {
		display: block;
		color: var(--text-main);
		margin-bottom: 0.5em;
		font-size: 1.1em;
	}
	.skill-category ul {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.skill-category li {
		color: var(--text-muted);
		margin-bottom: 0.3em;
	}
	.skill-category li::before {
		content: '•';
		color: var(--accent);
		display: inline-block;
		width: 1em;
	}
</style>
